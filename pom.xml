<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>dev.reliableevent</groupId>
    <artifactId>reliable-event-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>ReliableEvent</name>
    <description>Reliable event publishing with a transactional outbox</description>
    <url>https://github.com/xihaooooooo/reliable-event</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <scm>
        <connection>scm:git:https://github.com/xihaooooooo/reliable-event.git</connection>
        <url>https://github.com/xihaooooooo/reliable-event</url>
    </scm>

    <modules>
        <module>reliable-event-core</module>
        <module>reliable-event-jdbc</module>
        <module>reliable-event-rocketmq</module>
        <module>reliable-event-spring-boot-autoconfigure</module>
        <module>reliable-event-spring-boot-starter</module>
        <module>reliable-event-example</module>
        <module>reliable-event-benchmark</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <mysql.version>8.0.33</mysql.version>
        <rocketmq-client.version>5.2.1</rocketmq-client.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${maven.multiModuleProjectDirectory}</directory>
                <includes>
                    <include>LICENSE</include>
                </includes>
                <targetPath>META-INF</targetPath>
            </resource>
        </resources>
    </build>
</project>
